<Page x:Class="Практическая_работа_4_Филин_Березнев.pages.it_page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Практическая_работа_4_Филин_Березнев.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="it_page1">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Image Source="/png/zadanie_1.png" Grid.ColumnSpan="3" Margin="10,0,10,0"/>
        
        <Label Grid.Row="1" Content="x" Width="60" FontSize="20"/>
        <Label Grid.Row="2" Content="y" Width="60" FontSize="20"/>
        <Label Grid.Row="3" Content="z" Width="60" FontSize="20" />
        <Label Grid.Row="4" Content="Ответ" Width="60" FontSize="20" />
        
        <Button x:Name="vichislit" Grid.Row="1" Grid.Column="2" Content="Вычислить" Margin="10,0,190,0"/>
        <Button x:Name="otchistit" Grid.Row="4" Grid.Column="2" Content="Отчистить" Margin="10,0,190,0"/>

        <TextBox x:Name="x_znach" Grid.Row="1" Grid.Column="1" Text="TextBox"  FontSize="20"/>
        <TextBox x:Name="y_znach" Grid.Row="2" Grid.Column="1" Text="TextBox"  FontSize="20"/>
        <TextBox x:Name="z_znach" Grid.Row="3" Grid.Column="1" Text="TextBox"  FontSize="20"/>
        <TextBox x:Name="otvet" Grid.Row="4" Grid.Column="1" Text="TextBox"  FontSize="20"/>
       



    </Grid>
</Page>
