<Page x:Class="Практическая_работа_4_Филин_Березнев.pages.it_pages3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Практическая_работа_4_Филин_Березнев.pages"
      xmlns:charts="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="it_pages3">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition />
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="24*"/>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="12*"/>
            <RowDefinition Height="12*"/>
        </Grid.RowDefinitions>
        <WindowsFormsHost Grid.Column ="1" Grid.ColumnSpan="2" Grid.Row="1" Grid.RowSpan="4">
            <charts:Chart x:Name="ChartF">
                <charts:Chart.Legends>
                    <charts:Legend>

                    </charts:Legend>
                </charts:Chart.Legends>
            </charts:Chart>
        </WindowsFormsHost>
        <Image Source="/png/zadanie_3.png" Grid.ColumnSpan="3"/>
        <StackPanel Grid.Row="1">
            <!--<Label Content="x"  FontSize="15" Width="60" Height="30"   Margin="5,0,0,0" HorizontalAlignment="Left"/>-->
            <Label Content="b"  FontSize="15" Width="60" Height="30"   Margin="5,0,0,0" HorizontalAlignment="Left"/>
            <Label Content="x0"  FontSize="15" Width="60" Height="30"   Margin="5,0,0,0" HorizontalAlignment="Left"/>
            <Label Content="xk"  FontSize="15" Width="60" Height="30"   Margin="5,0,0,0" HorizontalAlignment="Left"/>
            <Label Content="dx"  FontSize="15" Width="60" Height="30"   Margin="5,0,0,0" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel Grid.Row="1">
            <!--<TextBox x:Name="x_znach" FontSize="20" Width="80" Height="20" HorizontalAlignment="Right" Margin="0,5,5,0"/>-->
            <TextBox x:Name="b_znach" ToolTip="Введите b" FontSize="14" Width="80" Height="20" HorizontalAlignment="Right"  Margin="0,5,5,0"/>
            <TextBox x:Name="x0_znach" ToolTip="Введите x0"  FontSize="14" Width="80" Height="20" HorizontalAlignment="Right"  Margin="0,10,5,0"/>
            <TextBox x:Name="xk_znacht" ToolTip="Введите xk"  FontSize="14" Width="80" Height="20" HorizontalAlignment="Right"  Margin="0,10,5,0"/>
            <TextBox x:Name="dx_znach" ToolTip="Введите шаг графика"  FontSize="14" Width="80" Height="20"   Margin="0,10,5,0" HorizontalAlignment="Right"/>
        </StackPanel>
        <Label Content="Ответ" Grid.Row="2" FontSize="15" Width="60" Height="30"   Margin="5,0,0,0" HorizontalAlignment="Left"/>
        <TextBox x:Name="otvet" IsEnabled="False" Grid.Row="2" Grid.RowSpan="2" Width="80" Height="80"   Margin="0,5,5,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
        <Button x:Name="vichislit" Grid.Row="4" Grid.Column="0" Content="Вычислить" Margin="10,0,0,5" Width="75" Height="30" HorizontalAlignment="Left" VerticalAlignment="Bottom" ToolTip="Вычислить значение функции" Click="vichislit_Click"/>
        <Button x:Name="otchistit" Grid.Row="4" Grid.Column="0" Content="Отчистить" Margin="0,0,5,5" Width="75" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" ToolTip="Очистить все поля" Click="otchistit_Click"/>

    </Grid>
</Page>
